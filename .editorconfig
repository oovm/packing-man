# Align with `nifty format` defaults (JetBrains / VS Code / Cursor).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}]
indent_style = space
indent_size = 4

[*.{vue,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 4

[*.pest]
indent_style = space
indent_size = 4
