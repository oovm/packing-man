{
    "name": "@sxo/packing",
    "version": "0.1.0",
    "description": "SXO packing host: wasm + node loaders",
    "type": "module",
    "license": "MIT",
    "bin": {
        "packing": "./bin/packing.mjs"
    },
    "exports": {
        "./wasm": {
            "types": "./dist/wasm/index.d.ts",
            "import": "./dist/wasm/index.js",
            "default": "./dist/wasm/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js",
            "default": "./dist/node/index.js"
        }
    },
    "files": ["dist", "bin"],
    "scripts": {
        "build": "node ../../../scripts/run-tsc.mjs tsconfig.json"
    },
    "optionalDependencies": {
        "@sxo/packing-darwin-arm64": "workspace:*",
        "@sxo/packing-darwin-x64": "workspace:*",
        "@sxo/packing-linux-arm64": "workspace:*",
        "@sxo/packing-linux-x64": "workspace:*",
        "@sxo/packing-win32-arm64": "workspace:*",
        "@sxo/packing-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@webgpu/types": "^0.1.60",
        "typescript": "catalog:"
    },
    "engines": { "node": ">=18" },
    "publish": false
}
