<template>
    <header class="site-header">
        <a data-vmz-route href="/" class="brand">
            <span class="brand-mark">PM</span>
            <span class="brand-text">SXO Packing</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
            <AppLink href="/" label="首页" :active="path === '/'" />
            <AppLink href="/demo" label="交互演示" :active="path === '/demo'" />
            <AppLink href="/fixtures" label="基准实例" :active="path === '/fixtures'" />
            <AppLink href="/about" label="关于" :active="path === '/about'" />
        </nav>
    </header>
</template>
<script client>
export default class SiteNav {
    path = "/";

    mounted() {
        this.syncPath();
        window.addEventListener("popstate", () => this.syncPath());
        document.addEventListener("click", (e) => {
            const anchor = (e.target as Element | null)?.closest?.("a[data-vmz-route]");
            if (anchor) {
                window.setTimeout(() => this.syncPath(), 0);
            }
        });
    }

    syncPath() {
        this.path = window.location.pathname.replace(/\/$/, "") || "/";
    }
}
</script>
