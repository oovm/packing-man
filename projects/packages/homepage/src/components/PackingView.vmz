<template>
    <div class="workspace">
        <section class="stage">
            <div id="pm-svg-host" class="svg-host"></div>
            <footer class="stage-meta">{{ status }}</footer>
        </section>
        <aside class="panel">
            <section class="panel-block">
                <h2>参数</h2>
                <p v-if="fixtureId" class="fixture-badge">基准：{{ fixtureId }}</p>
                <label>
                    容器半径
                    <input type="number" :value="containerR" min="1" step="0.5" @input="onContainerR" :disabled="!!fixtureId" />
                </label>
                <label>
                    圆半径
                    <input type="number" :value="circleR" min="0.1" step="0.1" @input="onCircleR" :disabled="!!fixtureId" />
                </label>
                <label>
                    圆数量
                    <input type="number" :value="count" min="1" max="200" step="1" @input="onCount" :disabled="!!fixtureId" />
                </label>
                <label>
                    算法
                    <select :value="algorithm" @change="onAlgorithm">
                        <option value="force">CPU 力松弛</option>
                        <option value="greedy">CPU 贪心</option>
                        <option value="concentric">同心环解析</option>
                        <option value="gpu">GPU 力松弛</option>
                    </select>
                </label>
                <button type="button" class="btn-primary" @click="onSolve">求解</button>
            </section>
        </aside>
    </div>
</template>
<style scoped>
.workspace { display: grid; grid-template-columns: 1fr minmax(220px, 280px); gap: 1.25rem; }
.svg-host { min-height: 440px; border: 1px solid var(--pm-border); border-radius: 12px; background: var(--pm-surface); overflow: hidden; }
.svg-host :deep(svg) { width: 100%; height: auto; display: block; }
.panel-block h2 { margin: 0 0 0.75rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pm-muted); }
.panel label { display: block; margin-bottom: 0.75rem; font-size: 0.875rem; color: var(--pm-muted); }
.panel input, .panel select { display: block; width: 100%; margin-top: 0.25rem; padding: 0.45rem 0.5rem; border-radius: 8px; border: 1px solid var(--pm-border); background: #fff; }
.panel input:disabled { opacity: 0.55; }
.fixture-badge { font-size: 0.8rem; color: var(--pm-accent); margin: 0 0 0.75rem; word-break: break-all; }
.btn-primary { width: 100%; margin-top: 0.25rem; padding: 0.55rem 1rem; border: none; border-radius: 8px; background: var(--pm-accent); color: #fff; font-weight: 600; cursor: pointer; }
.btn-primary:hover { filter: brightness(1.05); }
.stage-meta { margin-top: 0.65rem; color: var(--pm-muted); font-size: 0.85rem; font-family: ui-monospace, monospace; }
@media (max-width: 800px) {
    .workspace { grid-template-columns: 1fr; }
}
</style>
<script client>
import { runFixtureDemo, runPackingDemo } from "../lib/packing-frame";
import { fixtureJsonUrl } from "../lib/fixtures-catalog";

export default class PackingView {
    containerR = 10;
    circleR = 1;
    count = 19;
    algorithm = "force";
    fixtureId = "";
    status = "调整参数后点击「求解」";

    mounted() {
        const params = new URLSearchParams(window.location.search);
        const fixture = params.get("fixture");
        if (fixture) {
            this.fixtureId = fixture;
            this.status = `已加载基准 ${fixture}，点击求解`;
        }
    }

    onContainerR(e) {
        this.containerR = Number(e.target.value);
    }
    onCircleR(e) {
        this.circleR = Number(e.target.value);
    }
    onCount(e) {
        this.count = Number(e.target.value);
    }
    onAlgorithm(e) {
        this.algorithm = e.target.value;
    }

    async onSolve() {
        const host = document.getElementById("pm-svg-host");
        if (!host) return;
        this.status = "求解中…";
        try {
            const r = this.fixtureId
                ? await runFixtureDemo(host, fixtureJsonUrl(this.fixtureId))
                : await runPackingDemo(host, {
                      containerR: this.containerR,
                      circleR: this.circleR,
                      count: this.count,
                      algorithm: this.algorithm,
                  });
            this.status = `${r.algorithm} · obj ${r.objective.toFixed(4)} · density ${(r.density * 100).toFixed(1)}% · ${r.iterations} iters · ${r.feasible ? "feasible" : "infeasible"}`;
        } catch (err) {
            this.status = String(err);
        }
    }
}
</script>
